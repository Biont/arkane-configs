# ── Model ────────────────────────────────────────
LLAMA_ARG_HF_REPO=ggml-org/embeddinggemma-300m-qat-q8_0-GGUF
LLAMA_ARG_ALIAS=EmbeddingGemma-300M
# ── Network (own port; 12B stays on 7861) ────────
LLAMA_ARG_HOST=0.0.0.0
LLAMA_ARG_PORT=7862
# ── GPU / Performance ────────────────────────────
LLAMA_ARG_N_GPU_LAYERS=99
LLAMA_ARG_CTX_SIZE=2048
# ub MUST cover the longest input: pooled embeddings need the
# whole sequence in ONE physical batch, so keep ubatch == ctx
LLAMA_ARG_BATCH=2048
LLAMA_ARG_UBATCH=2048
LLAMA_ARG_BATCH_SIZE=2048
LLAMA_ARG_UBATCH_SIZE=2048
LLAMA_ARG_THREADS=8
LLAMA_ARG_PARALLEL=1
LLAMA_ARG_NO_CONTEXT_SHIFT=1
# ── Memory / IO ──────────────────────────────────
LLAMA_ARG_MMAP=1
LLAMA_ARG_MLOCK=0
# ── Acceleration ─────────────────────────────────
LLAMA_ARG_FLASH_ATTN=1
LLAMA_ARG_CONT_BATCHING=1
# ── Embeddings ───────────────────────────────────
LLAMA_ARG_EMBEDDINGS=1
LLAMA_ARG_POOLING=mean
LLAMA_ARG_UI=0

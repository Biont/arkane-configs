#!/bin/sh
# Goodix 27c6:6092 fingerprint reader fails to re-enumerate after S3.
# Unbind it before suspend so the kernel re-binds it cleanly on resume.

state=/run/goodix-fpr-suspend.busid

case "$1" in
    pre)
        for dev in /sys/bus/usb/devices/[0-9]*-[0-9]*; do
            [ -f "$dev/idVendor" ] || continue
            [ "$(cat "$dev/idVendor" 2>/dev/null)" = "27c6" ] || continue
            [ "$(cat "$dev/idProduct" 2>/dev/null)" = "6092" ] || continue
            busid=$(basename "$dev")
            printf '%s' "$busid" > "$state"
            printf '%s' "$busid" > /sys/bus/usb/drivers/usb/unbind 2>/dev/null
            break
        done
        ;;
    post)
        if [ -f "$state" ]; then
            busid=$(cat "$state")
            printf '%s' "$busid" > /sys/bus/usb/drivers/usb/bind 2>/dev/null
            rm -f "$state"
        fi
        ;;
esac
exit 0

#!/bin/sh
# Goodix 27c6:6092 fingerprint reader fails to resume (-107) after suspend/hibernate.
# Unbinding the driver is not enough, USB PM callbacks still run on the device.
# Disable its port before sleeping so it is fully disconnected, and re-enable the
# port on resume so the device re-enumerates cleanly.

state=/run/goodix-fpr-suspend.port

case "$1" in
    pre)
        for dev in /sys/bus/usb/devices/[0-9]*-[0-9]*; do
            [ -f "$dev/idVendor" ] || continue
            [ "$(cat "$dev/idVendor" 2>/dev/null)" = "27c6" ] || continue
            [ "$(cat "$dev/idProduct" 2>/dev/null)" = "6092" ] || continue
            port=$(readlink -f "$dev/port")
            [ -w "$port/disable" ] || break
            printf '%s' "$port" > "$state"
            echo 1 > "$port/disable"
            break
        done
        ;;
    post)
        if [ -f "$state" ]; then
            echo 0 > "$(cat "$state")/disable"
            rm -f "$state"
        fi
        ;;
esac
exit 0
